# Copy to .env and fill in. Never commit real keys.
# Upstream mode: "mock" (no key needed, deterministic demo responses)
# or "openai" (talks to any OpenAI-compatible /v1 endpoint).
UPSTREAM_MODE=mock
UPSTREAM_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=
UPSTREAM_TIMEOUT_S=60
DEFAULT_MODEL=mock-llm

# Admin key for /admin/* endpoints. Change this before any real deployment.
ADMIN_API_KEY=changeme-admin-key

# SQLite file for keys and audit log.
DB_PATH=./gatehouse.db

# Global rate limits (per API key unless overridden on the key itself).
RATE_LIMIT_RPM=60
RATE_LIMIT_BURST=10

# Injection policy: "block" or "flag". Scores are tunable thresholds.
INJECTION_POLICY=block
INJECTION_FLAG_SCORE=25
INJECTION_BLOCK_SCORE=50

# Redact PII found in upstream completions before returning them.
REDACT_COMPLETIONS=true

# Optional JSON price overrides, e.g. '{"my-model": {"input": 1.0, "output": 3.0}}'
# Prices are USD per 1M tokens.
PRICE_TABLE_JSON=
